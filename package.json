{
  "name": "fuzzy-waddle",
  "version": "0.1.1",
  "license": "UNLICENSED",
  "scripts": {
    "start:portal": "nx serve portal --outputStyle=stream",
    "start:api": "nx serve api --outputStyle=stream",
    "start": "nx run-many --all --target=serve",
    "start:portal-open": "nx serve portal --host=0.0.0.0 --disable-host-check",
    "start:probable-waffle-desktop": "nx serve probable-waffle-desktop",
    "postinstall": "node tools/assets/check-git-lfs.mjs --warn",
    "assets:check": "node tools/assets/check-git-lfs.mjs",
    "assets:hydrate": "git lfs install --local && git lfs pull && git lfs checkout",
    "phaser-editor:check": "node tools/phaser-editor/validate-project.mjs",
    "tauri:dev": "nx run probable-waffle-desktop:tauri-dev",
    "tauri:build": "nx run probable-waffle-desktop:tauri-build",
    "build": "nx run-many --all --target=build --configuration=production",
    "build-portal-dev": "nx build portal --source-map=true --named-chunks=true",
    "build-gh-pages": "nx build portal --base-href=/fuzzy-waddle/",
    "nx-build-portal": "nx build portal",
    "serve-build": "http-server dist/apps/portal",
    "sme": "nx build portal --source-map=true --named-chunks=true && source-map-explorer dist/apps/portal/**/*.js",
    "test": "nx run-many --all --target=test",
    "test:ci": "nx run-many --all --target=test --configuration=ci",
    "e2e": "nx run portal-e2e:e2e",
    "lint": "nx run-many --all --target=lint",
    "lint-fix": "nx run-many --all --target=lint --fix",
    "lint-staged": "nx run-many --all --target=lint --with-deps",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "nx": "nx",
    "dep-graph": "nx dep-graph",
    "workspace-schematic": "nx workspace-schematic",
    "update": "nx update @nx/workspace",
    "update:check": "nx update",
    "version:app": "node tools/ci/set-app-version.mjs",
    "version:check": "node tools/ci/check-version.mjs sync",
    "version:tauri": "pnpm run version:app --",
    "generate-audio-sprites": "pnpm assets:check && node ./apps/portal/src/metadata/sfx/generate-audio-sprites.js",
    "_docs_generate-supabase-types": "requires local Supabase stack; run supabase start first",
    "generate-supabase-types": "supabase gen types typescript --local --schema public > \"libs/platform/database-schema/src/lib/database/database.types.ts\"",
    "generate-supabase-types:remote": "supabase gen types typescript --project-id \"bhzetyxjimpabioxoodz\" --schema public > \"libs/platform/database-schema/src/lib/database/database.types.ts\""
  },
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": "11.14.0"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign.schema.json",
  "title": "Probable Waffle campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "catalogueVersion", "chapters"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "ashes-of-the-ancients"
    },
    "catalogueVersion": {
      "type": "integer",
      "minimum": 1
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "title",
          "subtitle",
          "summary",
          "layout",
          "artwork",
          "missionArtwork",
          "missionIds"
        ],
        "properties": {
          "id": {
            "enum": ["prologue", "two-homelands", "crystal-war", "united-against-volcano", "the-betrayal"]
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "layout": {
            "enum": ["single", "parallel", "collision", "united", "finale"]
          },
          "artwork": {
            "type": "object",
            "additionalProperties": false,
            "required": ["desktopSrc", "alt", "focalPosition"],
            "properties": {
              "desktopSrc": {
                "type": "string",
                "minLength": 1
              },
              "mobileSrc": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "focalPosition": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "missionArtwork": {
            "type": "object",
            "additionalProperties": false,
            "required": ["desktopSrc", "alt", "focalPosition"],
            "properties": {
              "desktopSrc": {
                "type": "string",
                "minLength": 1
              },
              "mobileSrc": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "focalPosition": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "missionIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "dreams",
                "cyclops-and-sheep",
                "snow-wendigo-and-fire",
                "slingshooters-and-wolves",
                "owl-and-skaduwee-crystal",
                "sand-dunes-and-tivara-crystal",
                "we-had-enough",
                "sailing-towards-the-new-future",
                "the-first-and-last-dinner",
                "the-siege",
                "time-rush",
                "joining-crystal",
                "mobster-or-friend",
                "the-volcano-is-getting-angry",
                "cult-wars",
                "the-volcano",
                "the-betrayal",
                "undead-and-cursed-lands",
                "end-game",
                "resolution"
              ]
            }
          }
        }
      }
    }
  }
}

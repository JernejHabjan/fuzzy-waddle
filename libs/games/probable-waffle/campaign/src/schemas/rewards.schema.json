{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuzzy-waddle.dev/schemas/probable-waffle/campaign/rewards.schema.json",
  "title": "Probable Waffle mission rewards",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "missionId", "rewards"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "missionId": {
      "enum": [
        "dreams",
        "cyclops-and-sheep",
        "snow-wendigo-and-fire",
        "slingshooters-and-wolves",
        "owl-and-skaduwee-crystal",
        "sand-dunes-and-tivara-crystal",
        "we-had-enough",
        "sailing-towards-the-new-future",
        "the-first-and-last-dinner",
        "the-siege",
        "time-rush",
        "joining-crystal",
        "mobster-or-friend",
        "the-volcano-is-getting-angry",
        "cult-wars",
        "the-volcano",
        "the-betrayal",
        "undead-and-cursed-lands",
        "end-game",
        "resolution"
      ]
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "titleTextId", "scope", "oneTime"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "currency",
              "story-unlock",
              "stat-tome",
              "item",
              "faction-unlock",
              "unit-unlock",
              "building-unlock",
              "technology-unlock",
              "temporary-boost",
              "temporary-resource",
              "temporary-unit"
            ]
          },
          "titleTextId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "scope": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "const": "global"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "faction"],
                "properties": {
                  "kind": {
                    "const": "faction"
                  },
                  "faction": {
                    "enum": [1, 2]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "objectName"],
                "properties": {
                  "kind": {
                    "const": "actor"
                  },
                  "objectName": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "oneTime": {
            "type": "boolean"
          },
          "objectiveIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hidden": {
            "type": "boolean"
          },
          "currencyId": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "number"
          },
          "unlockId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "upgradeId": {
            "type": "string",
            "minLength": 1
          },
          "itemDefinitionId": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "consumable": {
            "type": "boolean"
          },
          "objectName": {
            "type": "string",
            "minLength": 1
          },
          "researchType": {
            "type": "string",
            "minLength": 1
          },
          "temporaryBoostId": {
            "type": "string",
            "minLength": 1
          },
          "resourceType": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "currency" } } },
            "then": { "required": ["currencyId", "amount"] }
          },
          {
            "if": { "properties": { "kind": { "enum": ["story-unlock", "faction-unlock"] } } },
            "then": { "required": ["unlockId"] }
          },
          {
            "if": { "properties": { "kind": { "const": "stat-tome" } } },
            "then": { "required": ["upgradeId"] }
          },
          {
            "if": { "properties": { "kind": { "const": "item" } } },
            "then": { "required": ["itemDefinitionId", "quantity", "consumable"] }
          },
          {
            "if": { "properties": { "kind": { "enum": ["unit-unlock", "building-unlock"] } } },
            "then": { "required": ["unlockId", "objectName"] }
          },
          {
            "if": { "properties": { "kind": { "const": "technology-unlock" } } },
            "then": { "required": ["unlockId", "researchType"] }
          },
          {
            "if": { "properties": { "kind": { "const": "temporary-boost" } } },
            "then": { "required": ["temporaryBoostId"] }
          },
          {
            "if": { "properties": { "kind": { "const": "temporary-resource" } } },
            "then": { "required": ["resourceType", "amount"] }
          },
          {
            "if": { "properties": { "kind": { "const": "temporary-unit" } } },
            "then": { "required": ["objectName", "count"] }
          }
        ]
      }
    }
  }
}

{
  "schemaVersion": 1,
  "missionId": "cyclops-and-sheep",
  "texts": [
    { "id": "narrator-name", "text": "Narrator" },
    { "id": "tivara-hero-name", "text": "Tivara Scout" },
    { "id": "rescued-warrior-name", "text": "Rescued Warrior" },
    { "id": "cyclops-name", "text": "Cyclops" },
    {
      "id": "pond-intro-one-text",
      "text": "The river rose overnight, leaving two young frogs stranded beyond the dry bank."
    },
    { "id": "pond-intro-two-text", "text": "Bring them to the large pond. Their friends know a safe road home." },
    {
      "id": "carry-frogs-text",
      "text": "Select the scout, collect both stranded frogs, then carry them to the large pond."
    },
    { "id": "frogs-secured-text", "text": "Both are secure. Keep the scout moving toward the water." },
    { "id": "frogs-delivered-text", "text": "The frog party is together again. They point toward the old bridge." },
    {
      "id": "bridge-reveal-text",
      "text": "Corpy raiders hold the crossing. Clear them before searching for the missing Tivara."
    },
    { "id": "bridge-fight-text", "text": "Attack the bridge blockers and open the road." },
    { "id": "rescue-captives-text", "text": "Two Tivara warriors are held nearby. Reach them before continuing." },
    { "id": "companions-rescued-text", "text": "We owe you our freedom. We will help you cross the riverlands." },
    {
      "id": "cyclops-warning-text",
      "text": "A Cyclops patrols the canyon. Stay beyond its sight until you have a convincing disguise."
    },
    { "id": "boar-objective-text", "text": "The old boar carries curved tusks—and the shears lost by the shepherds." },
    { "id": "tools-acquired-text", "text": "Two tusks and the missing shears. Now find the sheep pasture." },
    {
      "id": "sheep-objective-text",
      "text": "Approach the flock and use the shears to gather enough wool for the party."
    },
    { "id": "sheep-clearing-text", "text": "The wool is ready, but the Corpy nest has sent a counterattack." },
    { "id": "counterattack-warning-text", "text": "Defend the clearing until the Corpy attackers are gone." },
    { "id": "prepare-disguise-text", "text": "Bring the tusks, shears, and wool to the sheltered preparation point." },
    {
      "id": "disguise-ready-text",
      "text": "From a distance, even a Cyclops should mistake this party for a wandering sheep."
    },
    { "id": "fool-cyclops-text", "text": "Stay together and walk calmly through the Cyclops pass." },
    { "id": "cyclops-fooled-text", "text": "Hmph. Woolly things. Not worth chasing." },
    {
      "id": "outro-text",
      "text": "The riverlands are behind us, and the rescued party carries word of a colder danger ahead."
    },
    { "id": "nest-destroyed-text", "text": "The Corpy nest is destroyed. The road will be safer for every traveler." },
    {
      "id": "canyon-lore-text",
      "text": "Old carvings show fire walking through snow—a warning from another homeland."
    },
    {
      "id": "cyclops-detected-text",
      "text": "The Cyclops spotted you. Fall back, regroup, and try the hidden route again."
    },
    { "id": "primary-title", "text": "Cross the riverlands" },
    {
      "id": "primary-description",
      "text": "Rescue the stranded party, assemble a sheep disguise, and pass the Cyclops."
    },
    { "id": "deliver-frogs-text", "text": "Carry both frogs to the large pond" },
    { "id": "rescue-companions-text", "text": "Free both captive Tivara" },
    { "id": "craft-disguise-text", "text": "Collect tusks, shears, and wool to craft the disguise" },
    { "id": "pass-cyclops-text", "text": "Fool the Cyclops and reach the far road" },
    { "id": "carry-title", "text": "Carry the stranded frogs" },
    { "id": "carry-description", "text": "Select the scout, collect both frogs, and move them to the safe pond." },
    { "id": "select-carrier-text", "text": "Select the Tivara scout" },
    { "id": "carry-frog-party-text", "text": "Collect both stranded frogs" },
    { "id": "move-to-pond-text", "text": "Carry the frogs to the large pond" },
    { "id": "melee-title", "text": "Clear the bridge" },
    { "id": "melee-description", "text": "Use a melee attack command to defeat the Corpy blocking the crossing." },
    { "id": "defeat-bridge-blockers-text", "text": "Defeat every bridge blocker" },
    { "id": "shearing-title", "text": "Gather sheep wool" },
    { "id": "shearing-description", "text": "Interact with the protected flock to shear three bundles of wool." },
    { "id": "interact-with-sheep-text", "text": "Shear the sheep in the clearing" },
    { "id": "stealth-title", "text": "Avoid the Cyclops" },
    { "id": "stealth-description", "text": "Use the hidden route and approach only after the party is disguised." },
    { "id": "optional-frogs-title", "text": "No frog left behind" },
    { "id": "optional-frogs-description", "text": "Deliver both stranded frogs safely." },
    { "id": "optional-companions-title", "text": "The whole party" },
    { "id": "optional-companions-description", "text": "Rescue both captive Tivara warriors." },
    { "id": "optional-nest-title", "text": "Safer riverlands" },
    { "id": "optional-nest-description", "text": "Destroy the Corpy nest at any point during the mission." },
    { "id": "optional-lore-title", "text": "Fire beneath the snow" },
    { "id": "optional-lore-description", "text": "Find the old canyon carving." },
    { "id": "failure-title", "text": "The scout has fallen" },
    { "id": "failure-description", "text": "The Tivara scout must survive to guide the rescued party home." },
    { "id": "unlock-snow-title", "text": "Snow Wendigo & Fire unlocked" },
    { "id": "riverland-crystal-title", "text": "Riverland crystal recovered" },
    { "id": "checkpoint-frogs-title", "text": "Checkpoint: Frogs reunited" },
    { "id": "checkpoint-frogs-resume", "text": "The reunited frogs point toward the guarded bridge." },
    { "id": "checkpoint-bridge-title", "text": "Checkpoint: Bridge secured" },
    { "id": "checkpoint-bridge-resume", "text": "Search beyond the bridge for the missing Tivara." },
    { "id": "checkpoint-companions-title", "text": "Checkpoint: Party rescued" },
    { "id": "checkpoint-companions-resume", "text": "The rescued warriors warn of the Cyclops patrol." },
    { "id": "checkpoint-tusks-title", "text": "Checkpoint: Tools recovered" },
    { "id": "checkpoint-tusks-resume", "text": "The tusks and shears are ready; find the sheep pasture." },
    { "id": "checkpoint-counterattack-title", "text": "Checkpoint: Wool gathered" },
    { "id": "checkpoint-counterattack-resume", "text": "Protect the disguise materials from the Corpy counterattack." },
    { "id": "checkpoint-disguise-title", "text": "Checkpoint: Disguise ready" },
    { "id": "checkpoint-disguise-resume", "text": "Walk the disguised party calmly through the Cyclops pass." }
  ],

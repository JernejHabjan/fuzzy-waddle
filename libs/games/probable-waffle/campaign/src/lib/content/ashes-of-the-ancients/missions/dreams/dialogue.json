  "texts": [
    {
      "id": "narrator-name",
      "text": "Narrator"
    },
    {
      "id": "tivara-captain-name",
      "text": "Tivara Captain"
    },
    {
      "id": "skaduwee-captain-name",
      "text": "Skaduwee Captain"
    },
    {
      "id": "dream-intro-one-text",
      "text": "In the same restless night, two homelands dreamed of fire."
    },
    {
      "id": "dream-intro-two-text",
      "text": "Their armies marched toward one ancient power beneath the volcano."
    },
    {
      "id": "tivara-rally-text",
      "text": "Tivara, rally. Direct the captain toward the battle."
    },
    {
      "id": "tivara-reminder-text",
      "text": "The dream waits. Select the Tivara captain and command the charge."
    },
    {
      "id": "tivara-charge-text",
      "text": "The first formation answers, and the mountain stirs."
    },
    {
      "id": "faction-handoff-text",
      "text": "The vision turns. Now see the march from the other homeland."
    },
    {
      "id": "skaduwee-rally-text",
      "text": "Skaduwee, advance. Bring your captain to the same battlefield."
    },
    {
      "id": "skaduwee-reminder-text",
      "text": "Command the Skaduwee captain toward the battle marker."
    },
    {
      "id": "skaduwee-charge-text",
      "text": "The second formation enters the ash."
    },
    {
      "id": "battle-escalation-text",
      "text": "Neither side hears the warning under its own battle cry."
    },
    {
      "id": "volcano-overwhelms-text",
      "text": "The volcano answers them both."
    },
    {
      "id": "ashes-title-text",
      "text": "Ashes of the Ancients"
    },
    {
      "id": "direct-tivara-title",
      "text": "Direct the Tivara army"
    },
    {
      "id": "direct-tivara-description",
      "text": "Select the Tivara captain and issue an attack or move command toward the central battle."
    },
    {
      "id": "command-tivara-charge-text",
      "text": "Command the Tivara captain into the battle region"
    },
    {
      "id": "direct-skaduwee-title",
      "text": "Direct the Skaduwee army"
    },
    {
      "id": "direct-skaduwee-description",
      "text": "After the handoff, command the Skaduwee captain toward the same battle."
    },
    {
      "id": "command-skaduwee-charge-text",
      "text": "Command the Skaduwee captain into the battle region"
    },
    {
      "id": "witness-dream-title",
      "text": "Witness the dream's outcome"
    },
    {
      "id": "witness-dream-description",
      "text": "Follow both armies until the volcano reveals what binds their homelands."
    },
    {
      "id": "technical-failure-title",
      "text": "The dream could not continue"
    },
    {
      "id": "technical-failure-description",
      "text": "A mission invariant failed. Retry the latest checkpoint or restart the prologue."
    },
    {
      "id": "unlock-cyclops-title",
      "text": "Cyclops & Sheep unlocked"
    },
    {
      "id": "after-dream-intro-title",
      "text": "Checkpoint: The shared dream"
    },
    {
      "id": "after-dream-intro-resume",
      "text": "The volcanic vision returns at the Tivara rally."
    },
    {
      "id": "after-tivara-charge-title",
      "text": "Checkpoint: Tivara charge"
    },
    {
      "id": "after-tivara-charge-resume",
      "text": "The dream turns toward Skaduwee."
    },
    {
      "id": "after-faction-switch-title",
      "text": "Checkpoint: Skaduwee rally"
    },
    {
      "id": "after-faction-switch-resume",
      "text": "Command the Skaduwee formation toward battle."
    },
    {
      "id": "before-volcano-finale-title",
      "text": "Checkpoint: The volcano answers"
    },
    {
      "id": "before-volcano-finale-resume",
      "text": "The final volcanic vision resumes."
    }

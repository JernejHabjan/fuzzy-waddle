{
  "name": "portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/portal/src",
  "prefix": "fuzzy-waddle",
  "tags": ["scope:portal", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{workspaceRoot}/dist/apps/portal"],
      "options": {
        "outputPath": {
          "base": "dist/apps/portal",
          "browser": ""
        },
        "index": "apps/portal/src/index.html",
        "browser": "apps/portal/src/main.ts",
        "polyfills": ["libs/platform/game-host/src/lib/angular/polyfills.ts", "@angular/localize/init"],
        "tsConfig": "apps/portal/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/portal/src/assets",
          "apps/portal/src/manifest.webmanifest",
          {
            "glob": "favicon.ico",
            "input": "libs/platform/game-host/src/assets",
            "output": "."
          },
          {
            "glob": "**/*",
            "input": "libs/platform/game-host/src/assets",
            "output": "assets",
            "ignore": ["favicon.ico"]
          },
          {
            "glob": "**/*",
            "input": "libs/games/dungeon-crawler/gameplay/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/games/fly-squasher/gameplay/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/games/little-muncher/gameplay/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/games/probable-waffle/gameplay/src/assets",
            "output": "assets"
          }
        ],
        "styles": ["libs/platform/game-host/src/styles/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/platform/game-host/src/styles"]
        },
        "serviceWorker": "apps/portal/ngsw-config.json",
        "allowedCommonJsDependencies": [
          "phaser",
          "websocket",
          "cross-fetch",
          "easystarjs",
          "ws",
          "@supabase/node-fetch",
          "eventemitter3",
          "mistreevous",
          "howler"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.5mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "48kb",
              "maximumError": "64kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "libs/platform/game-host/src/lib/environments/environment.ts",
              "with": "libs/platform/game-host/src/lib/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "portal:build:production"
        },
        "development": {
          "buildTarget": "portal:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/portal/proxy.conf.json"
      },
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "portal:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/portal/**/*.ts", "apps/portal/**/*.html"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/portal/jest.config.ts",
        "tsConfig": "apps/portal/tsconfig.spec.json"
      }
    }
  }
}

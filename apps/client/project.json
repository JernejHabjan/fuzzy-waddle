{
  "name": "client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/client/src",
  "prefix": "fuzzy-waddle",
  "tags": ["scope:client", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{workspaceRoot}/dist/apps/client"],
      "options": {
        "outputPath": {
          "base": "dist/apps/client",
          "browser": ""
        },
        "index": "apps/client/src/index.html",
        "browser": "apps/client/src/main.ts",
        "polyfills": ["apps/client/src/polyfills.ts", "@angular/localize/init"],
        "tsConfig": "apps/client/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/client/src/favicon.ico",
          "apps/client/src/assets",
          "apps/client/src/manifest.webmanifest",
          {
            "glob": "**/*",
            "input": "libs/games/dungeon-crawler/gameplay/src/assets",
            "output": "assets"
          }
        ],
        "styles": ["apps/client/src/styles/styles.scss"],
        "serviceWorker": "apps/client/ngsw-config.json",
        "allowedCommonJsDependencies": [
          "phaser",
          "websocket",
          "cross-fetch",
          "easystarjs",
          "ws",
          "@supabase/node-fetch",
          "eventemitter3",
          "mistreevous",
          "howler"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.5mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "48kb",
              "maximumError": "64kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/client/src/environments/environment.ts",
              "with": "apps/client/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "tauri": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "serviceWorker": false,
          "fileReplacements": [
            {
              "replace": "apps/client/src/environments/environment.ts",
              "with": "apps/client/src/environments/environment.prod.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "client:build:production"
        },
        "development": {
          "buildTarget": "client:build:development"
        },
        "tauri": {
          "buildTarget": "client:build:tauri"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/client/proxy.conf.json"
      },
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "client:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/client/**/*.ts", "apps/client/**/*.html"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/client/jest.config.ts",
        "tsConfig": "apps/client/tsconfig.spec.json"
      }
    },
    "tauri-dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx serve client --configuration=tauri",
          "cd apps/client && pnpm exec tauri dev"
        ],
        "parallel": true,
        "cwd": "{workspaceRoot}"
      }
    },
    "tauri-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx build client --configuration=tauri",
          "cd apps/client && pnpm exec tauri build"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}

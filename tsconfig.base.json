{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2024",
    "module": "ES2022",
    "lib": ["ES2024", "DOM"],
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noResolve": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "baseUrl": ".",
    "paths": {
      "@fuzzy-waddle/platform-identity": ["libs/platform/identity/src/index.ts"],
      "@fuzzy-waddle/platform-identity/*": ["libs/platform/identity/src/lib/*"],
      "@fuzzy-waddle/platform-chat": ["libs/platform/chat/src/index.ts"],
      "@fuzzy-waddle/platform-chat/*": ["libs/platform/chat/src/lib/*"],
      "@fuzzy-waddle/platform-game-sessions": ["libs/platform/game-sessions/src/index.ts"],
      "@fuzzy-waddle/platform-database-schema": ["libs/platform/database-schema/src/index.ts"],
      "@fuzzy-waddle/platform-database-schema/*": ["libs/platform/database-schema/src/lib/*"],
      "@fuzzy-waddle/platform-game-host": ["libs/platform/game-host/src/index.ts"],
      "@fuzzy-waddle/platform-game-host/angular/*": ["libs/platform/game-host/src/lib/angular/*"],
      "@fuzzy-waddle/platform-game-host/*": ["libs/platform/game-host/src/lib/game/*"],
      "@fuzzy-waddle/dungeon-crawler-gameplay": ["libs/games/dungeon-crawler/gameplay/src/index.ts"],
      "@fuzzy-waddle/dungeon-crawler-gameplay/*": ["libs/games/dungeon-crawler/gameplay/src/lib/*"],
      "@fuzzy-waddle/dungeon-crawler-interface": ["libs/games/dungeon-crawler/interface/src/index.ts"],
      "@fuzzy-waddle/dungeon-crawler-interface/*": ["libs/games/dungeon-crawler/interface/src/lib/*"],
      "@fuzzy-waddle/fly-squasher-gameplay": ["libs/games/fly-squasher/gameplay/src/index.ts"],
      "@fuzzy-waddle/fly-squasher-gameplay/*": ["libs/games/fly-squasher/gameplay/src/lib/*"],
      "@fuzzy-waddle/fly-squasher-interface": ["libs/games/fly-squasher/interface/src/index.ts"],
      "@fuzzy-waddle/fly-squasher-interface/*": ["libs/games/fly-squasher/interface/src/lib/*"],
      "@fuzzy-waddle/fly-squasher-protocol": ["libs/games/fly-squasher/protocol/src/index.ts"],
      "@fuzzy-waddle/fly-squasher-server": ["libs/games/fly-squasher/server/src/index.ts"],
      "@fuzzy-waddle/little-muncher-gameplay": ["libs/games/little-muncher/gameplay/src/index.ts"],
      "@fuzzy-waddle/little-muncher-gameplay/*": ["libs/games/little-muncher/gameplay/src/lib/*"],
      "@fuzzy-waddle/little-muncher-interface": ["libs/games/little-muncher/interface/src/index.ts"],
      "@fuzzy-waddle/little-muncher-interface/*": ["libs/games/little-muncher/interface/src/lib/*"],
      "@fuzzy-waddle/little-muncher-protocol": ["libs/games/little-muncher/protocol/src/index.ts"],
      "@fuzzy-waddle/little-muncher-server": ["libs/games/little-muncher/server/src/index.ts"],
      "@fuzzy-waddle/probable-waffle-protocol": ["libs/games/probable-waffle/protocol/src/index.ts"],
      "@fuzzy-waddle/probable-waffle-campaign": ["libs/games/probable-waffle/campaign/src/index.ts"],
      "@fuzzy-waddle/probable-waffle-campaign/*": ["libs/games/probable-waffle/campaign/src/lib/*"],
      "@fuzzy-waddle/probable-waffle-server": ["libs/games/probable-waffle/server/src/index.ts"],
      "@fuzzy-waddle/probable-waffle-gameplay": ["libs/games/probable-waffle/gameplay/src/index.ts"],
      "@fuzzy-waddle/probable-waffle-gameplay/*": ["libs/games/probable-waffle/gameplay/src/lib/*"],
      "@fuzzy-waddle/probable-waffle-phaser": ["libs/games/probable-waffle/phaser/src/index.ts"],
      "@fuzzy-waddle/probable-waffle-phaser/*": ["libs/games/probable-waffle/phaser/src/lib/*"],
      "@fuzzy-waddle/probable-waffle-interface": ["libs/games/probable-waffle/interface/src/index.ts"],
      "@fuzzy-waddle/probable-waffle-interface/*": ["libs/games/probable-waffle/interface/src/lib/*"],
      "@fuzzy-waddle/environments/*": ["libs/platform/game-host/src/lib/environments/*"],
      "passport-strategy": ["tools/types/passport-strategy.d.ts"],
      "profanity-cleaner": ["tools/types/profanity-cleaner.d.ts"]
    },
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "isolatedModules": true,
    "importsNotUsedAsValues": "remove",
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "declaration": false,
    "incremental": true,
    "tsBuildInfoFile": "./tmp/tsconfig.tsbuildinfo"
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
